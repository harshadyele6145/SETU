# SETU Environment Configuration Template
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=setu-super-secret-demo-key-2026-minimum-32-characters-required
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Connection (Supports SQLite for local zero-config, PostgreSQL for production)
# SQLite local:
DATABASE_URL=sqlite:///./setu.db
# PostgreSQL production / docker-compose:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/setu_db

# Local File Storage Abstraction
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,docx

# Demonstration Mode & Timezone
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata
DEMO_REFERENCE_DATE=2026-10-25T12:00:00+05:30

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Background Scheduler & Retries
SCHEDULER_INTERVAL_SECONDS=60
MAX_NOTIFICATION_RETRIES=3

